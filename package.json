{
  "name": "kms-tv",
  "private": true,
  "description": "KMS TV monorepo \u2014 JavaScript/TypeScript workspaces. Backend services are PHP and live outside this workspace.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "contracts:generate": "pnpm --filter @kms/ts-api-client run generate",
    "contracts:verify": "pnpm --filter @kms/ts-api-client run verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.10.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.67.0"
  }
}
