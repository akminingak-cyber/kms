{
  "name": "@kms/ts-api-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Typed clients for the KMS TV APIs. The types are generated from the OpenAPI contracts and are never hand-edited.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "verify": "node ./scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
