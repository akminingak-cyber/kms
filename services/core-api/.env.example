# KMS TV — core-api environment template.
#
# Copy to .env for local development:  cp .env.example .env
# Every value here is a placeholder. Real secrets are injected by the
# environment and never committed. See docs/security/secrets-and-key-management.md.

APP_NAME="KMS TV core-api"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL -------------------------------------------------------------
# One database, one schema per bounded context (ADR-0003).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kms
DB_USERNAME=kms
DB_PASSWORD=
# search_path is set explicitly; migrations create the per-context schemas.
DB_SEARCH_PATH="public,identity,profile,device,admin,catalog,schedule,product,billing,entitlement,rights,playback,media"

# Test database. Integration tests run against real PostgreSQL, never SQLite.
DB_TEST_DATABASE=kms_test

# --- Redis ------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array

# --- Tokens -----------------------------------------------------------------
# Ed25519 secret key, base64. Generate with: php artisan kms:generate-token-key
# There is no default: a missing key fails at boot rather than signing with
# something predictable.
KMS_TOKEN_SIGNING_KEY=
KMS_TOKEN_SIGNING_KEY_ID=k1
KMS_TOKEN_ISSUER=http://localhost:8080
KMS_TOKEN_AUDIENCE=kms-client
KMS_ACCESS_TOKEN_TTL=900
KMS_REFRESH_TOKEN_TTL=2592000

# --- Mail (local capture) ---------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="no-reply@kmstv.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# --- Limits (see config/kms.php for the full set) ---------------------------
KMS_DEVICE_LIMIT=5
KMS_MAX_PROFILES=6

# --- Delivery and media -----------------------------------------------------
# Where the origin serves media from. A CDN is a cache in front of this
# (ADR-0008); no CDN vendor is selected yet (OQ-8), so delivery is origin-direct.
KMS_ORIGIN_BASE_URL=http://localhost:8081

# Signs delivery tokens, which the origin verifies. A key of its own rather than
# the application key: it is shared with the origin, and eventually with a CDN,
# so it has a different blast radius and a different rotation schedule.
# There is no default, for the same reason as the token signing key above.
KMS_DELIVERY_TOKEN_KEY=

# Which networks may reach the internal delivery-authorization endpoint.
# Comma-separated CIDRs. **Empty denies everything**: a deployment that has not
# said where its origin runs does not get an open token-verification oracle.
KMS_ORIGIN_NETWORKS=127.0.0.1/32

# How long a delivery token lasts, and therefore the upper bound on how long a
# stopped or newly blacked-out session can keep receiving segments. The origin
# verifies tokens without a database read, so this number is the revocation
# latency.
KMS_DELIVERY_TOKEN_TTL=300

# How often a live session is re-checked against rights and entitlement. The
# maximum enforcement lag for a blackout that begins mid-event.
KMS_REVALIDATION_INTERVAL=300

# Where generated manifests are written. A local volume shared with the origin
# in development; object storage in production.
KMS_MANIFEST_DISK=manifests
KMS_MANIFEST_ROOT=/srv/media
