<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true"
         failOnDeprecation="false"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Integration tests run against real PostgreSQL and real Redis.
             Never SQLite: it silently accepts SQL PostgreSQL rejects, and
             rejects SQL PostgreSQL accepts, which converts a caught bug into a
             production incident. -->
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>modules</directory>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="DB_CONNECTION" value="pgsql_test"/>
        <env name="CACHE_STORE" value="redis"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="REDIS_DB" value="15"/>
        <env name="REDIS_CACHE_DB" value="15"/>
        <!-- A fixed, throwaway signing key so tests are deterministic. It is
             worthless: it signs nothing outside the test database. -->
        <env name="KMS_TOKEN_SIGNING_KEY" value="z+R/aZjxo4eCVRhHPuPKq3hrZaHrv8SilBIsCbLkt9k0MbQdqf49ZDE2DvBLhCrshPuAORJFqrRpQnSvsSnN2Q=="/>
        <env name="KMS_TOKEN_ISSUER" value="http://localhost"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
    </php>
</phpunit>
